@3  80000015  // 3:  XOR @15 
@4  20000000  // 4:  SKZ     
@5  00000000  // 5:  HLT     
@6  A0000016  // 6:  LDA @16 
@7  20000000  // 7:  SKZ     
@8  E000000A  // 8:  JMP @A  
@9  00000000  // 9:  HLT     
@A  A0000017  // 10: LDA @17 
@B  C0000018  // 11: STO @18 
@C  E0000011  // 12: JMP @11 
@D  00000000  // 13: HLT     
@E  00000000  // 14: HLT     
@F  00000000  // 15: HLT     
@10 00000000  // 16: HLT     
@11 00000000  // 17: HLT     

