      <ZoomEndTime time="160.001 ns"></ZoomEndTime>
      <Cursor1Time time="24.200 ns"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="179"></NameColumnWidth>
      <ValueColumnWidth column_width="89"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="6" />
   <wvobject fp_name="/tb_Memory/clk" type="logic">
