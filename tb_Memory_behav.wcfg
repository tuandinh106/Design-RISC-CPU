      <obj_property name="ObjectShortName">clk</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_Memory/rd" type="logic">
      <obj_property name="ElementShortName">rd</obj_property>
      <obj_property name="ObjectShortName">rd</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_Memory/wr" type="logic">
      <obj_property name="ElementShortName">wr</obj_property>
      <obj_property name="ObjectShortName">wr</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_Memory/addr_mem" type="array">
      <obj_property name="ElementShortName">addr_mem[31:0]</obj_property>
      <obj_property name="ObjectShortName">addr_mem[31:0]</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_Memory/data_to_write" type="array">
